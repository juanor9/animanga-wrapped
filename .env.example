# AniList OAuth Configuration
NEXT_PUBLIC_AL_ID=your_anilist_client_id
AL_SECRET=your_anilist_secret

# Backend API URL (use http://localhost:3000 for development)
NEXT_PUBLIC_REACT_APP_BASE_URL=http://localhost:3000

# Wrapped Year Configuration
NEXT_PUBLIC_YEAR=2025

# Database Configuration
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/animanga-wrapped?retryWrites=true&w=majority

# JWT Secret (generate a strong random string, minimum 32 characters)
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_long

# Vercel Blob Storage (get from Vercel Dashboard > Storage > Create Blob Store)
# For local development, you can leave this empty - uploads will work in production
AMW_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxx

# Email Service
# Option 1: Resend (Recommended)
RESEND_API_KEY=re_123456789
# EMAIL_FROM=onboarding@resend.dev

# Option 2: SMTP (Legacy)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Option 3: SendGrid (Deprecated)
# SENDGRID_API_KEY=SG.xxxxxxxxxxxxx

# Sender email
EMAIL_FROM=noreply@animanga-wrapped.com
